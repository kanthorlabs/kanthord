# Copy to .env and fill in. .env is gitignored; .env.example is committed.

# Shared secret for the HTTP API (`kanthord serve`). Sent as HTTP Basic auth:
#   Authorization: Basic base64(<any-username>:<API_KEY>)
# The username is ignored. Minimum 16 characters — `serve` refuses to start
# with a shorter, blank or missing value. Generate one with:
#   openssl rand -hex 32
API_KEY=
